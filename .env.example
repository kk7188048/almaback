# dev | prod.  In prod the app REFUSES to start with default/short secrets or LLM_PROVIDER=mock.
ENV=dev
CORS_ORIGINS=https://portal.example.com

# ---- required -------------------------------------------------------------------------------
POSTGRES_PASSWORD=change-me
JWT_SECRET=generate-with-openssl-rand-hex-32
WEBHOOK_SIGNING_SECRET=generate-with-openssl-rand-hex-32
UPLOAD_SIGNING_SECRET=generate-with-openssl-rand-hex-32
PUBLIC_BASE_URL=https://eval.example.com

# ---- LLM (free-tier friendly) ---------------------------------------------------------------
# mock    : deterministic offline provider, no account needed (default; good for demos and tests)
# gemini  : Google AI Studio free tier       LLM_API_KEY=...   models e.g. gemini-2.0-flash
# openai_compat : Groq / OpenRouter / vLLM   LLM_API_KEY=... LLM_BASE_URL=https://api.groq.com/openai/v1
# bedrock : AWS Bedrock (production target, uses the instance/task IAM role; no key in this file)
LLM_PROVIDER=mock
# LLM_API_KEY=
# LLM_BASE_URL=
# LLM_MODEL_CHEAP=gemini-2.0-flash
# LLM_MODEL_STANDARD=gemini-2.0-flash
# LLM_MODEL_PREMIUM=gemini-2.0-flash
LLM_MAX_CONCURRENCY=4

# ---- storage --------------------------------------------------------------------------------
# local : files on a docker volume (single host). s3 : AWS S3 (free tier 5 GB) - recommended, uploads go browser -> S3 directly
STORAGE_BACKEND=local
# S3_BUCKET=your-bucket
# S3_REGION=ap-south-1
# S3_ENDPOINT_URL=http://minio:9000        # only for MinIO; leave unset for AWS
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY: omit on EC2/ECS and use the instance/task IAM role
#
# Cloudflare R2 (S3-compatible, no egress fees): create a bucket + an R2 API token (Object Read & Write), then
#   STORAGE_BACKEND=s3
#   S3_BUCKET=<bucket>
#   S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
#   S3_REGION=auto
#   S3_PRESIGN_MODE=put            # R2 does not support presigned POST policies
#   AWS_ACCESS_KEY_ID=<R2 token access key id>
#   AWS_SECRET_ACCESS_KEY=<R2 token secret>
#   (then: python -m app.cli s3-configure, and set the bucket CORS rule in the R2 dashboard if it reports a failure)

# ---- optional integrations ------------------------------------------------------------------
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY=                  # PEM with \n escapes; enables private-repo evaluation
# GOOGLE_API_KEY=                          # Drive API key; enables public Google Drive folder import
# CLAMD_HOST=clamav                        # with: docker compose --profile clamav up -d
# CLAMAV_REQUIRED=false
# TRANSCRIPTION_BASE_URL=https://api.groq.com/openai/v1
# TRANSCRIPTION_API_KEY=                   # enables video transcription (needs INSTALL_FFMPEG=true build arg)
# SEMGREP_ENABLED=false

# ---- limits / policy (defaults shown) -------------------------------------------------------
# DAILY_SUBMISSION_CAP=20
# ATTEMPT_TOKEN_BUDGET=600000
# GLOBAL_DAILY_TOKEN_BUDGET=20000000
# MAX_ATTEMPTS=3
# WORKER_CONCURRENCY=1
